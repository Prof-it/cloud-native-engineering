variable "keycloak_url" {
  description = "Base URL Terraform uses to reach the admin API (port-forward in the local track)."
  type        = string
  default     = "http://localhost:8080"
}

variable "public_url" {
  description = "Hostname Keycloak issues tokens for (spec.hostname.hostname of the Keycloak CR). Issuer = public_url/realms/<realm>."
  type        = string
  default     = "http://keycloak.localtest.me:8080"
}

variable "portal_redirect_uris" {
  description = "Exact redirect URIs of the portal SPA. No wildcards (G4)."
  type        = list(string)
  default     = ["http://portal.localtest.me:3000/callback"]
}

variable "kubernetes_issuer" {
  description = "Service-account token issuer of the cluster. kind: https://kubernetes.default.svc.cluster.local; AKS: the cluster's oidc_issuer_url."
  type        = string
  default     = "https://kubernetes.default.svc.cluster.local"
}

variable "workload_namespace" {
  description = "Namespace of the API and the worker."
  type        = string
  default     = "claims"
}

variable "broker_secret" {
  description = "Secret shared by the corporate client platform-broker and the broker in the platform realm. Generated by scripts/live-up.sh (TF_VAR_broker_secret); never stored in plan or state."
  type        = string
  sensitive   = true
  ephemeral   = true
}

variable "broker_secret_version" {
  description = "Increase together with a new broker_secret to rotate it on both sides."
  type        = number
  default     = 1
}

variable "demo_user_password" {
  description = "Initial password of the demo user in the simulated corporate directory. Temporary: the user must change it at first login."
  type        = string
  sensitive   = true
  ephemeral   = true
}
